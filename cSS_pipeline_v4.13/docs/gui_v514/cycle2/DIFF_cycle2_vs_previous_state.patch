+log = open(f"{out}/label_access_log.csv").read().splitlines()
+check("refusals are logged with granted=0", all(l.endswith(",0") for l in log[1:] if l.split(",")[1] in ho) and any(l.split(",")[1] in ho for l in log[1:]))
