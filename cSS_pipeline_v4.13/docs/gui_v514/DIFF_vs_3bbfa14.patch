+    return {f: sha(f) for f in sorted(fs)}
+
+
+def run_auto(PAT, write_results_file, queue_unified):
+    import unified_gui as UG
+    res = {}
+    done = [p for p in PAT if p.get("status") == "done" and os.path.exists(f"{B}/review/{p['code']}_candidates.csv")]
+    # T1
